{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordwatch.example/schemas/lookup-response.schema.json",
  "title": "LookupResponse",
  "type": "object",
  "properties": {
    "meaning": {
      "type": "string",
      "minLength": 1
    },
    "example": {
      "type": "string",
      "minLength": 1
    },
    "tr": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "minProperties": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "isIdiom": {
      "type": "boolean"
    },
    "expression": {
      "type": [
        "string",
        "null"
      ]
    },
    "usage": {
      "type": "string"
    },
    "audio": {
      "type": [
        "string",
        "null"
      ]
    },
    "cached": {
      "type": "boolean"
    }
  },
  "required": [
    "meaning",
    "example",
    "tr",
    "confidence",
    "isIdiom"
  ]
}
